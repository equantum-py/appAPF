  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "rulebook.edition.created",
          "rulebook.editions.read",
          "rulebook.edition.read",
          "organization.memberships.read",
          "audit.events.read",
          "situation.version.published",
          "physical.exercise.version.published",
          "training.run.started",
          "training.run.completed",
          "physical.result.recorded",
          "evaluation.review.recorded"
        ],
        "title": "Action"
      },
      "Attributes": {
        "properties": {
          "returned_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Returned Count"
          },
          "version_number": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Number"
          },
          "modality": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PHYSICAL",
                  "COGNITIVE_DECISION"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Modality"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Attributes"
      },
      "AuditEvent": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Organization Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "actor_user_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor User Id"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Action"
              },
              {
                "type": "string",
                "const": "legacy.unknown"
              }
            ],
            "title": "Action"
          },
          "details": {
            "$ref": "#/components/schemas/ProjectedDetails"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "organization_id",
          "created_at",
          "actor_user_id",
          "action",
          "details"
        ],
        "title": "AuditEvent"
      },
      "AuditPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cursor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AuditPage"
      },
      "Cursor": {
        "properties": {
          "before_at": {
            "type": "string",
            "format": "date-time",
            "title": "Before At"
          },
          "before_id": {
            "type": "string",
            "format": "uuid",
            "title": "Before Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "before_at",
          "before_id"
        ],
        "title": "Cursor"
      },
      "Edition": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Organization Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "organization_id",
          "created_at",
          "label"
        ],
        "title": "Edition"
      },
      "EditionInput": {
        "properties": {
          "label": {
            "type": "string",
